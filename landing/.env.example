# Public URL of this landing site (used for canonical links, sitemap and OG images).
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where "Start learning" sends people. On Vercel this defaults to https://linguini-navy.vercel.app.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# --- Optional: search and launch (leave empty until you have them) ---
# Custom domain move: old hosts that should 301 to NEXT_PUBLIC_SITE_URL, comma-separated.
REDIRECT_FROM_HOSTS=
# Google Search Console "HTML tag" method: the content="" value only.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta tag (msvalidate.01): the content="" value only.
BING_SITE_VERIFICATION=
# Any 8–128 character hex string; served at /indexnow-key.txt for scripts/indexnow.mjs.
INDEXNOW_KEY=
# Product Hunt listing URL and numeric post id (from the badge embed code) after launch.
NEXT_PUBLIC_PRODUCT_HUNT_URL=
NEXT_PUBLIC_PRODUCT_HUNT_POST_ID=
