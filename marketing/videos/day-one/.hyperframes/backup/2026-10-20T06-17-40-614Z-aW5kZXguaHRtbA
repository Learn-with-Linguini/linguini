  <script>
    const tl = gsap.timeline({ paused: true });

    tl.fromTo('#progress-fill', { width: '0%' }, { width: '100%', duration: 30, ease: 'none' }, 0);
    tl.fromTo('#mascot', { y: 0, rotation: -2 }, { y: -12, rotation: 2, duration: 1.2, repeat: 24, yoyo: true, ease: 'sine.inOut' }, 0);

    const scenes = [
      { id: '#scene-0', start: 0, end: 4, sub: 'Day one. Your first lesson is already on the table.' },
      { id: '#scene-1', start: 4, end: 10, sub: 'One photo — Linguini finds the words in it.' },
      { id: '#scene-2', start: 10, end: 15, sub: 'AI suggests. You decide what enters the lesson.' },
      { id: '#scene-3', start: 15, end: 20, sub: 'Two-way I-Spy. Find the word, then give the clue.' },
      { id: '#scene-4', start: 20, end: 26, sub: 'Every photo keeps its words — revisit them any time.' },
      { id: '#scene-5', start: 26, end: 30, sub: 'Public beta — unlimited photo lessons at learnwithlinguini.com.' }
    ];

    scenes.forEach(s => {
      tl.to(s.id, { autoAlpha: 1, duration: 0.3, ease: 'power2.out' }, s.start);
      tl.call(() => {
        document.getElementById('sub-bar').textContent = s.sub;
      }, null, s.start);
      if (s.end < 30) {
        tl.to(s.id, { autoAlpha: 0, duration: 0.3, ease: 'power2.in' }, s.end - 0.3);
      }
    });

    // Scene 0
    tl.fromTo('#hero-photo-card', { x: 80, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, 0.4);

    // Scene 1
    tl.fromTo('#detect-card', { scale: 0.92, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: 'power3.out' }, 4.4);
    tl.fromTo('#chip-1', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'back.out(1.6)' }, 5.3);
    tl.fromTo('#chip-2', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'back.out(1.6)' }, 5.9);
    tl.fromTo('#chip-3', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'back.out(1.6)' }, 6.5);
    tl.fromTo('#chip-4', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'back.out(1.6)' }, 7.1);

    // Scene 2 — photo + marker list in, rows stagger, then two rejects get removed
    tl.fromTo('#s2-photo', { x: 80, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, 10.3);
    tl.fromTo('#s2-list', { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, 10.7);
    tl.fromTo('#rr1, #rr2, #rr3, #rr4, #rr5, #rr6', { x: 40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, stagger: 0.22, ease: 'power2.out' }, 11.2);
    tl.to('#rr5, #rr6', { autoAlpha: 0, x: 60, height: 0, paddingTop: 0, paddingBottom: 0, duration: 0.45, ease: 'power2.in' }, 13.4);

    // Scene 3 — photo, clue card, choices; correct answer highlights + marker ring
    tl.fromTo('#s3-photo', { scale: 0.94, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: 'power3.out' }, 15.4);
    tl.fromTo('#s3-clue', { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: 'power3.out' }, 15.9);
    tl.fromTo('#s3-choices .choice', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, stagger: 0.15, ease: 'power2.out' }, 16.4);
    tl.to('#opt-correct', { backgroundColor: '#eef6f3', borderColor: '#21716F', color: '#21716F', duration: 0.3 }, 17.8);
    tl.to('#opt-tick', { opacity: 1, duration: 0.25 }, 17.9);
    tl.to('#mark3-ring', { opacity: 1, duration: 0.3, ease: 'power2.out' }, 18.0);

    // Scene 4 — revisit card in, word rows stagger, button pulses
    tl.fromTo('#revisit-card', { rotationY: -12, opacity: 0 }, { rotationY: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, 20.4);
    tl.fromTo('#v1, #v2, #v3, #v4', { x: 40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, stagger: 0.25, ease: 'power2.out' }, 21.4);
    tl.fromTo('#revisit-btn', { scale: 1 }, { scale: 1.06, duration: 0.4, yoyo: true, repeat: 1, ease: 'sine.inOut' }, 23.4);

    window.__timelines = window.__timelines || {};
