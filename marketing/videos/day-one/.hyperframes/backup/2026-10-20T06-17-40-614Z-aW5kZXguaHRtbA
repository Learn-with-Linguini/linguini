<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Linguini — Day One (LinkedIn)</title>
  <style>
    @font-face {
      font-family: 'Baloo';
      src: url('assets/Baloo2-ExtraBold.ttf');
      font-weight: 800;
    }
    @font-face {
      font-family: 'Nunito';
      src: url('assets/NunitoSans-Bold.ttf');
      font-weight: 700;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #FFF9ED;
      font-family: 'Nunito', sans-serif;
      color: #263238;
    }
    #root {
      position: relative;
      width: 1920px;
      height: 1080px;
      overflow: hidden;
      background: #FFF9ED;
    }
    .absolute { position: absolute; }
    .scene {
      position: absolute;
      inset: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
    }
    .scene.active {
      opacity: 1;
      visibility: visible;
    }

    /* Cards */
    .card {
      background: #ffffff;
      border: 2px solid #f0e6cf;
      border-radius: 28px;
      box-shadow: 0 20px 45px rgba(38, 50, 56, 0.08);
      overflow: hidden;
    }
    .card--lifted {
      box-shadow: 0 30px 60px rgba(38, 50, 56, 0.12);
    }

    /* Header */
    .header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 110px;
      padding: 36px 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 100;
    }
    .brand-pill {
      background: #ffffff;
      padding: 10px 24px;
      border-radius: 999px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid #f0e6cf;
    }
    .brand-pill img {
      height: 38px;
      display: block;
    }
    .day-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #E85D32;
      color: #FFF9ED;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2px;
      padding: 12px 26px;
      border-radius: 999px;
      box-shadow: 0 6px 18px rgba(232, 93, 50, 0.3);
    }

    /* Step badge */
    .number-badge {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
    }
    .number-badge .num {
      font-family: 'Baloo', sans-serif;
      font-size: 48px;
      line-height: 1;
      color: #E85D32;
    }
    .number-badge .label {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 3px;
      color: #21716F;
      text-transform: uppercase;
    }

    /* Typography */
    .headline-main {
      font-family: 'Baloo', sans-serif;
      font-size: 68px;
      line-height: 1.12;
      letter-spacing: -1.5px;
      color: #263238;
      margin: 0 0 16px 0;
    }
    .headline-accent { color: #E85D32; }
    .headline-teal { color: #21716F; }
    .subtext {
      font-size: 29px;
      line-height: 1.45;
      color: #5b6670;
      margin: 0;
      max-width: 780px;
    }

    /* Subtitle bar */
    .subtitle-bar-wrap {
      position: absolute;
      bottom: 40px;
      left: 70px;
      right: 70px;
      display: flex;
      justify-content: center;
      z-index: 100;
    }
    .subtitle-bar {
      background: rgba(38, 50, 56, 0.92);
      color: #ffffff;
      font-size: 26px;
      font-weight: 700;
      padding: 16px 36px;
      border-radius: 999px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      letter-spacing: 0.5px;
      text-align: center;
    }

    /* Progress */
    .progress-bar-track {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 8px;
      background: rgba(0, 0, 0, 0.08);
      z-index: 100;
    }
    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: #E85D32;
    }

    /* Mascot */
    .mascot-host {
      position: absolute;
      bottom: 50px;
      right: 70px;
      width: 140px;
      height: 140px;
      z-index: 90;
    }
    .mascot-host img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Word chips (app marker style) */
    .word-chip {
      position: absolute;
      z-index: 5;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FFF9ED;
      border: 3px solid #263238;
      color: #263238;
      padding: 10px 20px;
      border-radius: 999px;
      font-size: 24px;
      font-weight: 800;
      box-shadow: 5px 6px 0 #F9B233;
      white-space: nowrap;
    }
    .word-chip .dot {
      width: 12px;
      height: 12px;
      background: #E85D32;
      border-radius: 50%;
    }

    /* Numbered photo markers (ScenePhoto style) */
    .pmark {
      position: absolute;
      z-index: 5;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #E85D32;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Baloo', sans-serif;
      font-size: 26px;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    }
    .pmark-ring {
      position: absolute;
      z-index: 4;
      border-radius: 50%;
      border: 4px solid #21716F;
      box-shadow: 0 0 0 6px rgba(33, 113, 111, 0.25), 0 4px 14px rgba(0,0,0,0.2);
      opacity: 0;
    }

    /* Scene-analysis word list (PracticeAnalysis) */
    .analysis-card {
      background: #ffffff;
      border: 2px solid #f0e6cf;
      border-radius: 24px;
      box-shadow: 0 24px 50px rgba(38, 50, 56, 0.1);
      overflow: hidden;
    }
    .analysis-card .ahead {
      padding: 18px 26px 10px;
      border-bottom: 2px solid #f6efdd;
    }
    .analysis-card .ahead strong {
      display: block;
      font-size: 24px;
      font-weight: 800;
      color: #263238;
    }
    .analysis-card .ahead small {
      font-size: 18px;
      color: #8a949b;
    }
    .rrow {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 26px;
      font-size: 25px;
      font-weight: 800;
      color: #263238;
      border-bottom: 1px solid #f6efdd;
      overflow: hidden;
    }
    .rrow:last-child { border-bottom: none; }
    .rrow .mnum {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #E85D32;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Baloo', sans-serif;
      font-size: 20px;
      flex-shrink: 0;
    }
    .rrow .rmv {
      margin-left: auto;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 2px solid #e9e2d0;
      background: #fff;
      color: #9aa4ab;
      font-size: 19px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* I-Spy (ISpyPhase1) */
    .clue-card {
      background: #ffffff;
      border: 2px solid #f0e6cf;
      border-radius: 24px;
      box-shadow: 0 24px 50px rgba(38, 50, 56, 0.1);
      padding: 20px 28px;
    }
    .clue-card .clue-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .clue-card .clue-label {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #8a949b;
    }
    .clue-card .speaker {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid #e9e2d0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .clue-quote {
      font-family: 'Baloo', sans-serif;
      font-size: 33px;
      color: #263238;
      line-height: 1.2;
      margin: 0;
    }
    .choice-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .choice {
      padding: 15px 22px;
      border-radius: 16px;
      border: 2px solid #e9e2d0;
      font-size: 24px;
      font-weight: 800;
      background: #ffffff;
      color: #263238;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .choice .tick { opacity: 0; font-size: 22px; }

    /* Revisit card (Vocabulary scene card) */
    .revisit-card {
      background: #ffffff;
      border: 2px solid #f0e6cf;
      border-radius: 28px;
      box-shadow: 0 30px 60px rgba(38, 50, 56, 0.12);
      overflow: hidden;
    }
    .revisit-photo {
      position: relative;
      height: 400px;
      overflow: hidden;
    }
    .revisit-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .revisit-count {
      position: absolute;
      left: 20px;
      top: 20px;
      background: rgba(38, 50, 56, 0.88);
      color: #FFF9ED;
      font-size: 20px;
      font-weight: 800;
      padding: 8px 18px;
      border-radius: 999px;
    }
    .revisit-btn {
      position: absolute;
      right: 20px;
      bottom: 20px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #E85D32;
      color: #FFF9ED;
      font-family: 'Baloo', sans-serif;
      font-size: 24px;
      padding: 12px 26px;
      border-radius: 999px;
      box-shadow: 0 8px 20px rgba(232, 93, 50, 0.4);
    }
    .revisit-body { padding: 22px 28px 26px; }
    .revisit-title {
      font-family: 'Baloo', sans-serif;
      font-size: 34px;
      color: #263238;
      margin: 0 0 14px;
    }
    .vrow {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 9px 0;
      border-bottom: 1px solid #f6efdd;
    }
    .vrow:last-child { border-bottom: none; }
    .vrow .vw strong {
      display: block;
      font-size: 26px;
      font-weight: 800;
      color: #263238;
    }
    .vrow .vw small {
      font-size: 19px;
      color: #6f787d;
    }
    .vrow .vhear {
      margin-left: auto;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 2px solid #e9e2d0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
  </style>
